<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlashMem.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="620"
        x:Class="FlashMem.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="760"
        Height="430"
        MinWidth="760"
        MinHeight="430"
        MaxWidth="760"
        MaxHeight="430"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FBF7EF"
        Foreground="#333333"
        FontFamily="Segoe UI"
        FontSize="12"
        KeyDown="OnWindowKeyDown">
    <Window.Styles>
        <Style Selector="ListBox">
            <Setter Property="BorderBrush" Value="#CBCBCB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBF7EF"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#F9EBCE"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="BorderBrush" Value="#CBCBCB"/>
            <Setter Property="Background" Value="#FBF7EF"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Styles>

    <Border Margin="4"
            Padding="6"
            CornerRadius="0"
            BorderBrush="#CBCBCB"
            BorderThickness="1"
            Background="#FBF7EF">
        <Grid ColumnDefinitions="280,1,*" RowDefinitions="Auto,*" ColumnSpacing="8" RowSpacing="6">
            <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                <Button Grid.Column="0" Content="New" Click="OnNewClicked"/>
                <Button Grid.Column="1" Content="Delete" Click="OnDeleteClicked"/>
                <Button Grid.Column="2" Content="Archive" Click="OnArchiveClicked"/>
                <Button Grid.Column="3" Content="Save" Click="OnSaveClicked"/>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.75" Text="Hotkey: double tap key"/>
            </Grid>

            <ListBox Grid.Row="1"
                     Grid.Column="0"
                     ItemsSource="{Binding Notes}"
                     SelectedItem="{Binding SelectedNoteItem, Mode=TwoWay}"
                     Background="#FBF7EF">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoteListItemViewModel">
                        <Grid RowDefinitions="Auto,Auto" Margin="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding UpdatedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                       Opacity="0.6"
                                       FontSize="10"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Grid.Column="1" Width="1" Background="#CBCBCB"/>

            <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBox Grid.Row="0"
                         Watermark="Title"
                         Text="{Binding NoteTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="1"
                         Watermark="Content"
                         Text="{Binding NoteContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
