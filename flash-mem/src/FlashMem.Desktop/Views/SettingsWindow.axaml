<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlashMem.Desktop.Views.SettingsWindow"
        Width="420"
        Height="270"
        MinWidth="420"
        MinHeight="270"
        MaxWidth="420"
        MaxHeight="270"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="Flash Mem Settings">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
        <TextBlock Text="Double Tap Key" FontWeight="SemiBold"/>
        <ComboBox x:Name="HotkeyCombo" Grid.Row="1"/>

        <TextBlock Grid.Row="2" Text="Double Tap Window (ms)" FontWeight="SemiBold"/>
        <TextBox x:Name="DoubleTapWindowTextBox" Grid.Row="3"/>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <CheckBox x:Name="StartAtLoginCheckBox" Content="Start at login"/>
            <Button Grid.Column="1" Content="Cancel" Click="OnCancelClicked"/>
            <Button Grid.Column="2" Content="Save" Click="OnSaveClicked"/>
        </Grid>
    </Grid>
</Window>
